{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justsomeshed.com/JSwartz/HinterOS/hinteros-catalog/schema/index.schema.json",
  "title": "HinterOS catalog index",
  "description": "Generated from apps/*.nix by lib.mkIndex (indexVersion 2). Read by the session daemon and the launcher's Store UI. Receivers ignore unknown fields and treat unknown enum values as documented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexVersion", "apps"],
  "properties": {
    "indexVersion": { "const": 2 },
    "apps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/App" },
          { "$ref": "#/$defs/RemovedApp" }
        ]
      }
    }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "HomePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        { "pattern": "^[^/~]" },
        { "not": { "pattern": "(^|/)(\\.\\.?)?(/|$)" } }
      ]
    },
    "Https": { "type": "string", "pattern": "^https://\\S+$" },
    "App": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "summary", "description", "category", "homepage", "kind", "sizeMiB",
        "icon", "requires", "depends", "conflicts", "installer", "onIso", "installerDefault",
        "dataPaths", "terms", "status", "statusReason", "buildsOnDevice", "free", "redistributable"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "category": {
          "description": "Unknown values: show under 'Other'.",
          "enum": ["games", "video", "music", "photos", "utilities"]
        },
        "homepage": { "$ref": "#/$defs/Https" },
        "kind": {
          "description": "As in apps.list. Unknown values: native.",
          "enum": ["native", "web"]
        },
        "sizeMiB": { "type": "integer", "minimum": 1, "description": "Approximate download plus disk use" },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the session daemon finds the real icon at runtime; HinterOS ships no logos. siteUrl defaults to homepage.",
          "properties": {
            "desktopId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "siteUrl": { "$ref": "#/$defs/Https" },
            "iconUrl": { "$ref": "#/$defs/Https", "description": "The vendor's own public logo; the daemon downloads and caches it at runtime (https, at most 1 MiB). Optional." },
            "firefoxProfile": { "type": "boolean" }
          }
        },
        "requires": { "type": "array", "items": { "enum": ["graphics32"] } },
        "depends": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "installer": {
          "type": "boolean",
          "description": "Listed in the installer's and first-boot wizard's app selection (always true for onIso apps; other apps appear when online)"
        },
        "onIso": {
          "type": "boolean",
          "description": "Ships on the ISO, so an offline install can select it"
        },
        "installerDefault": {
          "type": "boolean",
          "description": "Pre-selected in the app selection. Still an ordinary app: it can be removed later"
        },
        "dataPaths": {
          "type": "array",
          "description": "Paths relative to a profile's home that hold the app's data; deleted in every profile when the user removes the app and chooses to delete its data",
          "items": { "$ref": "#/$defs/HomePath" }
        },
        "terms": {
          "description": "The vendor's full terms, shown before install. null when the app has none",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "version", "url", "retrieved", "file"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$", "description": "The vendor's version or revision date; the box records which version was accepted" },
                "url": { "$ref": "#/$defs/Https" },
                "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "When the text was copied from url" },
                "file": { "type": "string", "pattern": "^terms/[A-Za-z0-9._-]+\\.txt$", "description": "Plain UTF-8 text, relative to this index file" }
              }
            }
          ]
        },
        "status": { "enum": ["available", "retired"] },
        "statusReason": { "type": ["string", "null"], "maxLength": 200 },
        "buildsOnDevice": {
          "type": "boolean",
          "description": "Unfree and not cached: fetched from the vendor and built on the box during install. Unfree apps with cache = true (Steam) come from the binary cache"
        },
        "free": { "type": "boolean" },
        "redistributable": { "type": "boolean" }
      }
    },
    "RemovedApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "statusReason"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "status": { "const": "removed" },
        "statusReason": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
